# Trading Capture System — local development environment template.
# Copy to `.env` (gitignored) and adjust if needed. Every value here is a
# development placeholder; no production or real credential ever goes in this file.

# --- docker-compose infrastructure ---
# Host port for the containerized MySQL (default 3307 — this machine runs a local
# mysqld on 3306; set to 3306 if your machine does not).
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=tcs_root_dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
# Kafka broker host port and Schema Registry host port (container port 8081; host 8085
# because 8081-8084 belong to the application services).
KAFKA_HOST_PORT=9092
SCHEMA_REGISTRY_HOST_PORT=8085

# --- per-service MySQL users (created by infrastructure/docker/mysql/init) ---
TRADING_DB_USER=trading_svc
TRADING_DB_PASSWORD=trading_dev
ACCOUNT_DB_USER=account_svc
ACCOUNT_DB_PASSWORD=account_dev
ENRICHMENT_DB_USER=enrichment_svc
ENRICHMENT_DB_PASSWORD=enrichment_dev
ALLOCATION_DB_USER=allocation_svc
ALLOCATION_DB_PASSWORD=allocation_dev

# --- OIDC (Keycloak realm `tcs`, imported from infrastructure/docker/keycloak) ---
OIDC_ISSUER=http://localhost:8180/realms/tcs
# Full stack only (docker-compose.full.yml, ADR-0018): services validate the issuer above but
# fetch JWKS from the in-network Keycloak URL. Left blank for host-run services (JWKS discovered
# from the issuer). The override sets it to http://keycloak:8180/realms/tcs/protocol/openid-connect/certs.
OIDC_JWK_SET_URI=
# Machine-client secrets matching the dev realm export:
ALLOCATION_ENGINE_CLIENT_SECRET=allocation-engine-dev-secret
TRADING_SERVICE_CLIENT_SECRET=trading-service-dev-secret
ACCOUNT_SERVICE_CLIENT_SECRET=account-service-dev-secret

# --- admin-web (apps/admin-web/.env.local for Next.js; kept here as the single reference) ---
# AUTH_SECRET: generate per machine, e.g. `openssl rand -base64 32` (session cookie encryption)
AUTH_SECRET=generate-me-per-machine
AUTH_KEYCLOAK_ID=admin-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/tcs
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRADING_SERVICE_URL=http://localhost:8081
ACCOUNT_SERVICE_URL=http://localhost:8082
ENRICHMENT_SERVICE_URL=http://localhost:8083
ALLOCATION_ENGINE_URL=http://localhost:8084

# Observability (Phase 11) — Prometheus + Grafana local dev values only
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_dev
