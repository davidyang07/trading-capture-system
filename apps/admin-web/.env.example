# admin-web local development template — copy to .env.local (gitignored).
# Values must stay development placeholders; see root .env.example for the full set.
# NOTE: Auth.js/OIDC variables become active in Phase 10; listed here so the target
# session architecture (ADR-0010) is visible from the start.
AUTH_SECRET=generate-me-per-machine
AUTH_KEYCLOAK_ID=admin-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/tcs
TRADING_SERVICE_URL=http://localhost:8081
ACCOUNT_SERVICE_URL=http://localhost:8082
ENRICHMENT_SERVICE_URL=http://localhost:8083
ALLOCATION_ENGINE_URL=http://localhost:8084
