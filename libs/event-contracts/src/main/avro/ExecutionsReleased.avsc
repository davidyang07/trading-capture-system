{
    "type": "record",
    "namespace": "com.tradingcapture.events",
    "name": "ExecutionsReleased",
    "doc": "Previously allocated executions were released back to UNALLOCATED during a Replace/Cancel flow (state EXECUTIONS_RELEASED, emitted from Phase 8 orchestration). Topic tcs.allocation.executions-released.v1, key = allocId.",
    "fields": [
        {
            "name": "metadata",
            "type": "com.tradingcapture.events.EventMetadata",
            "doc": "Shared event envelope."
        },
        {
            "name": "allocId",
            "type": "string",
            "doc": "Business allocation identifier of the Replace/Cancel instruction that triggered the release."
        },
        {
            "name": "refAllocId",
            "type": "string",
            "doc": "Referenced allocation whose executions were released (FIX tag 72, RefAllocID)."
        },
        {
            "name": "releasedExecutionIds",
            "type": {
                "type": "array",
                "items": "string"
            },
            "doc": "Execution identifiers released back to UNALLOCATED."
        }
    ]
}
