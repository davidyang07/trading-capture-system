<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tradingcapture</groupId>
        <artifactId>trading-capture-system</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>security-support</artifactId>
    <name>security-support</name>
    <description>Shared OAuth2 resource-server building blocks: Keycloak claim mapping, audience
        validation, and the standardized RFC 7807 problem contract (ADR-0008, ADR-0014)</description>

    <!-- The Spring web/security artifacts are provided by the consuming service (both are web
         resource servers); marking them provided keeps this library from imposing starters and
         avoids version drift, while still compiling against the managed Boot versions. -->
    <dependencies>
        <dependency>
            <groupId>com.tradingcapture</groupId>
            <artifactId>observability-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
