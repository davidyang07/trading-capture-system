<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.tradingcapture</groupId>
    <artifactId>trading-capture-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Trading Capture System</name>
    <description>Distributed trading capture system: trading, account, enrichment, and allocation services</description>

    <properties>
        <java.version>21</java.version>
        <quickfixj.version>2.3.2</quickfixj.version>
        <!-- QuickFIX/J 2.3.2 requests MINA 2.2.4. Pin the compatible 2.2.x security release so
             fixable MINA deserialization CVEs never enter the allocation-engine image. -->
        <mina.version>2.2.9</mina.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <springdoc.version>2.8.9</springdoc.version>
        <avro.version>1.12.0</avro.version>
        <!-- cp-7.9.x tracks Apache Kafka 3.9, matching the kafka-clients version managed by
             Spring Boot 3.5 (ADR-0004; docker-compose runs the same cp image line). -->
        <confluent.version>7.9.1</confluent.version>
        <!-- Resilience4j 2.3.x targets Spring Boot 3 / Spring Framework 6 (Phase 8 M2M clients). -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <!-- WireMock 3.x (standalone, shaded) for the Phase 8 M2M-client HTTP tests. -->
        <wiremock.version>3.9.2</wiremock.version>
        <!-- Phase 12 JaCoCo gate. Kept false only while measuring baseline coverage; the
             Phase 12 gate sets it to true so `./mvnw verify` fails below 80% line / 70% branch. -->
        <jacoco.haltOnFailure>true</jacoco.haltOnFailure>
        <!-- Pin the JaCoCo plugin (the Spring Boot parent does not manage it) so the coverage
             gate is reproducible; 0.8.15 supports the JDK 21/24 used here. -->
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <!-- Confluent's serializer stack is not published to Maven Central. This is the one
         additional repository this build trusts (anticipated by .mvn/settings.xml); it is
         a public, credential-free repository. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <modules>
        <module>libs/observability-support</module>
        <module>libs/security-support</module>
        <module>libs/event-contracts</module>
        <module>libs/test-support</module>
        <module>services/trading-service</module>
        <module>services/account-service</module>
        <module>services/enrichment-service</module>
        <module>services/allocation-engine</module>
        <!-- Phase 12: cross-service end-to-end scenarios. Compiles in the reactor; its tests
             self-skip unless FULL_STACK=1 (the live stack must be up). Ships no production code. -->
        <module>tests/full-system-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tradingcapture</groupId>
                <artifactId>observability-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradingcapture</groupId>
                <artifactId>security-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradingcapture</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradingcapture</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.quickfixj</groupId>
                <artifactId>quickfixj-core</artifactId>
                <version>${quickfixj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.quickfixj</groupId>
                <artifactId>quickfixj-messages-fix44</artifactId>
                <version>${quickfixj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.mina</groupId>
                <artifactId>mina-core</artifactId>
                <version>${mina.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Phase 12: JaCoCo coverage gate (master-plan: 80% line / 70% branch, generated
                 code excluded). The agent is attached to every module's test run; the report is
                 written at verify; the check enforces the per-module gate. Generated Avro classes
                 (com.tradingcapture.events.**) are excluded (they are build output, not authored
                 code). Modules that ship only generated or test-only infrastructure set
                 jacoco.skip in their own POM (documented there). Version is managed by the
                 Spring Boot parent. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/tradingcapture/events/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Flipped to true for the Phase 12 gate once every module meets
                                 the threshold; kept false only during initial measurement. -->
                            <haltOnFailure>${jacoco.haltOnFailure}</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
